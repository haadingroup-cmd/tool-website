# Public canonical URL of the live site (no trailing slash). Used for canonical tags, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://www.smarterbiz.uk

# Supabase (server-side only — never expose the service role key to the browser).
# Run supabase/setup-all.sql, then supabase/migrations/0002_reviews_moderation.sql, in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Sign-in (magic link). The anon key is safe to hold server-side; it is never sent to the browser here.
SUPABASE_ANON_KEY=

# Optional: Google Search Console / Bing Webmaster verification codes.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional: IndexNow key (8–128 letters/digits, e.g. `openssl rand -hex 16`). Served at /indexnow-key.txt;
# every production deploy then pings Bing & co. with all sitemap URLs.
INDEXNOW_KEY=

# Newsletter: secret for signing unsubscribe links (32+ random chars, e.g. `openssl rand -hex 32`).
NEWSLETTER_SECRET=

# Optional: emails via Resend (resend.com): newsletter welcome, review published/rejected, listing claim decisions.
# EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="SmarterBiz.uk <briefing@smarterbiz.uk>"

# Optional: Cloudflare Turnstile captcha on sign-in and review forms. Without both keys the widget is hidden
# and the server skips the check. The site key is inlined at build time, so redeploy after setting it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Upstash Redis for rate limits shared by every server instance (in-memory per instance without it).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
